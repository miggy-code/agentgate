# agentgate runs fully offline with the mock model. Nothing here is required.
# Copy to .env and fill in only if you want the optional real model adapter.

# Model backend: "mock" (default, offline) or "anthropic".
AGENTGATE_MODEL=mock

# Needed only when AGENTGATE_MODEL=anthropic. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an
# `ant auth login` profile instead of a key.
ANTHROPIC_API_KEY=

# Claude model id for AGENTGATE_MODEL=anthropic: claude-opus-5-5 (default),
# claude-sonnet-5-5 or claude-haiku-5-5. Install the extra: pip install 'agentgate[anthropic]'.
AGENTGATE_ANTHROPIC_MODEL=claude-opus-5-5
